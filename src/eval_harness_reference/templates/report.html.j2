<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>评测报告：{{ report.evaluation_id }}</title>
  <style>
    body { color: #172033; font: 16px/1.65 system-ui, sans-serif; margin: 0 auto; max-width: 960px; padding: 32px; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #d7deea; padding: 8px 12px; text-align: left; }
    th { background: #f2f6fb; }
    code { background: #eef3f8; padding: 2px 5px; }
  </style>
</head>
<body>
  <main>
    <h1>评测报告：{{ report.evaluation_id }}</h1>
    <h2>运行摘要</h2>
    <p>计划 Trial：{{ report.trial_ids | length }}；评分记录：{{ report.scores | length }}</p>
    <h2>评分记录</h2>
    <table><thead><tr><th>Score</th><th>Trial</th><th>状态</th><th>值</th></tr></thead><tbody>
    {% for score in report.scores %}<tr><td><code>{{ score.score_id }}</code></td><td>{{ score.trial_id }}</td><td>{{ score.status }}</td><td>{{ score.value }}</td></tr>{% endfor %}
    </tbody></table>
    <h2>指标</h2>
    <table><thead><tr><th>Metric</th><th>分子/分母</th><th>值</th></tr></thead><tbody>
    {% for metric in report.metrics %}<tr><td><code>{{ metric.metric_id }}</code></td><td>{{ metric.numerator }}/{{ metric.denominator }}</td><td>{{ "%.4f" | format(metric.value) }}</td></tr>{% endfor %}
    </tbody></table>
    <h2>质量门禁</h2>
    <table><thead><tr><th>Gate</th><th>状态</th><th>依据指标</th><th>原因</th></tr></thead><tbody>
    {% for gate in report.gates %}<tr><td>{{ gate.gate_id }}</td><td>{{ gate.status }}</td><td>{{ gate.metric_ids | join(', ') }}</td><td>{{ gate.reason }}</td></tr>{% endfor %}
    </tbody></table>
  </main>
</body>
</html>
